VELAROS_SERVER_BIND=127.0.0.1
PORT=8787
VELAROS_SERVER_PUBLIC_ORIGIN=https://server.example.com
VELAROS_SERVER_DATA_DIR=/var/lib/velaros-server
VELAROS_SERVER_EXECUTION_ROOT=/srv/apps
VELAROS_SERVER_FILE_ROOTS_JSON='["/srv/apps","/var/log"]'
VELAROS_SERVER_EXECUTION_MODE=workspace-write
VELAROS_SERVER_APPROVAL=ask
