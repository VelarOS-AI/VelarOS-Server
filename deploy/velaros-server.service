[Unit]
Description=VelarOS Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=velaros
Group=velaros
WorkingDirectory=/opt/velaros-server
EnvironmentFile=/etc/velaros-server.env
ExecStart=/usr/bin/node /opt/velaros-server/dist/apps/server/src/main.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=mixed
UMask=0077

[Install]
WantedBy=multi-user.target
